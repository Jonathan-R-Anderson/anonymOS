#!/bin/busybox sh
# boot/gatekeeper/init — PID 1 of the anonymOS boot GATEKEEPER (a minimal-Linux UKI the §E5
# pre-boot loader StartImages after it routes a password to DECOY or HIDDEN — see the README).
#
# It IP-gates the HIDDEN OS: only a whitelisted network reaches it; anything else fails to a
# REJECT (indistinguishable from a wrong password). The DECOY route runs the IDENTICAL dance and
# boots the decoy regardless — so the two boots look the same to an observer.
#
# INDISTINGUISHABILITY (the whole point — do not "optimize" these away):
#   * CONSTANT TIME  — every route pads to GK_DEADLINE before handing off, so a decoy boot, a
#                      passing hidden boot, and a failing→reject attempt all take the same time.
#   * SAME TRAFFIC   — the DECOY route runs the same Tor + vault fetch and discards the result, so
#                      the on-the-wire signature is identical whichever password was typed.
#   * SILENT         — all logging goes to /run/gk.log (tmpfs), NEVER console/serial. Nothing
#                      route- or outcome-specific is ever printed.
#   NB one thing this stage CANNOT fix alone: a WRONG password must also produce this same dance
#   (see README "Unsolved") or the real password is distinguishable by its boot-time traffic.
#
# ┌ !!! UNTESTED DRAFT. Boot-critical. kexec/reject hand-offs are placeholders; the §E5 loader must ┐
# │ pass gkroute/gkkey/geometry; build + iterate in a THROWAWAY VM. See README.                     │
# └───────────────────────────────────────────────────────────────────────────────────────────────┘
B=/bin/busybox
$B mount -t proc proc /proc 2>/dev/null
$B mount -t sysfs sys /sys 2>/dev/null
$B mount -t devtmpfs dev /dev 2>/dev/null
$B mount -t tmpfs tmp /run 2>/dev/null

# SILENCE: everything from here goes to tmpfs, not the console/serial the coercer can watch.
exec >>/run/gk.log 2>&1
log(){ $B echo "$(cut -d' ' -f1 /proc/uptime) $*"; }

# Constant-time deadline: read the boot clock now; hold_to_deadline() pads to START+GK_DEADLINE on
# EVERY exit path. GK_DEADLINE must exceed the worst-case Tor+fetch so padding is always downward
# (a fetch that overruns it would leak timing). Overridable via the gkdeadline= cmdline param.
START=$($B cut -d. -f1 /proc/uptime)
GK_DEADLINE=90
hold_to_deadline(){
  now=$($B cut -d. -f1 /proc/uptime)
  end=$((START + GK_DEADLINE))
  while [ "$($B cut -d. -f1 /proc/uptime)" -lt "$end" ]; do $B sleep 1; done
}

for pass in 1 2 3 4 5 6 7 8; do for m in /mod/*.ko; do $B insmod "$m" 2>/dev/null; done; done

# ── loader handoff (INTEGRATION: confirm names against efi_main.c) ───────────────────────────
#   gkroute=decoy|hidden   which universe the loader matched (it holds the matching volume key)
#   gkpass=<pw>            the typed password (for the attestation id/key + WiFi creds)
#   gkvault=/gkrpc=/gkipsvc=   attestation contract / L2 RPC / public-IP endpoint (via Tor)
#   gkkey=/gkrl=/gkiv=/gksz=   the matched volume's key + geometry, for kexec-ing that OS
route=""; pw=""; vault=""; rpc=""; ipsvc=""
for tok in $($B cat /proc/cmdline); do case "$tok" in
  gkroute=*) route=${tok#gkroute=} ;; gkpass=*) pw=${tok#gkpass=} ;;
  gkvault=*) vault=${tok#gkvault=} ;; gkrpc=*) rpc=${tok#gkrpc=} ;;
  gkipsvc=*) ipsvc=${tok#gkipsvc=} ;; gkdeadline=*) GK_DEADLINE=${tok#gkdeadline=} ;;
esac; done
salt=$($B cat /esp/anonymos/attest.salt 2>/dev/null)

# ── the DANCE — run identically for decoy and hidden (traffic uniformity) ────────────────────
WIFI_ENC=/esp/anonymos/wifi.enc
is_wireless(){ [ -d "/sys/class/net/$1/wireless" ] || [ -e "/sys/class/net/$1/phy80211" ]; }
have_route(){ $B ip route 2>/dev/null | $B grep -q '^default'; }
net_up(){
  $B ip link set lo up 2>/dev/null
  for d in /sys/class/net/*; do [ -e "$d" ] || continue; n=$($B basename "$d"); [ "$n" = lo ] && continue; is_wireless "$n" && continue
    $B ip link set "$n" up 2>/dev/null; $B udhcpc -i "$n" -n -q -t 3 -T 3 2>/dev/null && have_route && return 0; done
  for d in /sys/class/net/*; do [ -e "$d" ] || continue; n=$($B basename "$d"); is_wireless "$n" || continue
    [ -f "$WIFI_ENC" ] || continue
    printf '%s' "$pw" | /bin/attest-unseal --decrypt-file "$WIFI_ENC" --salt "$salt" > /tmp/wpa.conf 2>/dev/null || continue
    $B ip link set "$n" up 2>/dev/null; wpa_supplicant -B -i "$n" -c /tmp/wpa.conf >/dev/null 2>&1 || { $B rm -f /tmp/wpa.conf; continue; }
    ok=""; for i in $($B seq 1 30); do wpa_cli -i "$n" status 2>/dev/null | $B grep -q 'wpa_state=COMPLETED' && { ok=1; break; }; $B sleep 1; done
    [ -n "$ok" ] && $B udhcpc -i "$n" -n -q -t 3 -T 3 2>/dev/null && have_route && { $B rm -f /tmp/wpa.conf; return 0; }
    $B rm -f /tmp/wpa.conf; done
  return 1
}
# Returns ALLOW / DENY / BLACKLIST / ERR — same code runs on both routes (decoy discards it).
run_check(){
  net_up || { log "no network"; echo ERR; return; }
  tor -f /etc/tor/torrc >/tmp/tor.log 2>&1 &
  ok=""; for i in $($B seq 1 60); do $B nc -z 127.0.0.1 9050 2>/dev/null && { ok=1; break; }; $B sleep 1; done
  [ -n "$ok" ] || { log "no tor"; echo ERR; return; }
  T="--socks5-hostname 127.0.0.1:9050"
  id=$(printf '%s' "$pw" | /bin/attest-unseal --derive-id --salt "$salt" 2>/dev/null) || { echo ERR; return; }
  data="0x8eaa6ac0${id}"
  req="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_call\",\"params\":[{\"to\":\"$vault\",\"data\":\"$data\"},\"latest\"]}"
  resp=$(curl -s --max-time 30 $T -H 'Content-Type: application/json' -d "$req" "$rpc" 2>/dev/null) || { echo ERR; return; }
  rec=$(printf '%s' "$resp" | /bin/attest-unseal --decode-ethcall --password "$pw" --salt "$salt" 2>/dev/null) || { echo ERR; return; }
  myip=$(curl -s --max-time 30 $T "${ipsvc:-https://check.torproject.org/api/ip}" 2>/dev/null | $B grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | $B head -n1)
  [ -n "$myip" ] || { echo ERR; return; }
  printf '%s' "$rec" | /bin/attest-unseal --match "$myip" 2>/dev/null || echo ERR
}
verdict=$(run_check)
log "route=$route verdict=$verdict"

# ── decide outcome (no early exits — every path reaches hold_to_deadline) ─────────────────────
outcome=REJECT
if [ "$route" = decoy ]; then
  outcome=DECOY                              # decoy always boots; the check above was only for traffic parity
elif [ "$route" = hidden ] && [ "$verdict" = ALLOW ]; then
  outcome=REAL
fi                                           # hidden+anything-else, or unknown route → REJECT

hold_to_deadline                             # <-- constant time: all outcomes leave here together

# ── hand off (INTEGRATION: replace with real kexec / reject-to-loader) ───────────────────────
case "$outcome" in
  REAL)   log "-> real"; : ;;   # TODO kexec the hidden OS with gkkey/geometry
  DECOY)  log "-> decoy"; : ;;  # TODO kexec the decoy with gkkey/geometry
  *)      log "-> reject"; : ;; # TODO reset back to the loader's prompt, indistinguishable from a wrong password
esac
# Placeholders: DO NOT SHIP. Must transfer control (kexec) or reset — never fall through.
exec $B sh
