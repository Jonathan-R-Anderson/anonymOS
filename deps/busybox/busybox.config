# BusyBox config fragment for EpinAnonymOS — Track A (SHELL_AND_COMMANDS_ROADMAP A1).
#
# Applied on top of busybox `defconfig` (see deps/busybox/Makefile), so we get the
# FULL default applet set (~390 commands: ls, cp, mv, find, grep, sed, awk, vi, less,
# top, free, mount, tar, dd, …) and this fragment only:
#   1. forces a static / musl build,
#   2. disables the one applet that fails to build against musl (tc),
#   3. drops applets that are meaningless on EpinAnonymOS (kernel modules — we have
#      none; init/linuxrc/switch_root — the OS has its own init path; mdev — no
#      kernel devtmpfs uevents),
#   4. pins ash as /bin/sh and /bin/bash with bash compat.
# Everything else inherits defconfig, which is the standard, build-tested busybox set.

# ── Build flavour ─────────────────────────────────────────────────────────────
CONFIG_STATIC=y
CONFIG_LONG_OPTS=y
# CONFIG_PIE is not set
# CONFIG_DEBUG is not set
CONFIG_EXTRA_CFLAGS="-O2 -pipe"
CONFIG_EXTRA_LDFLAGS="--static"

# ── Shell: ash is sh + bash, with bash compatibility + job control ────────────
# STANDALONE + PREFER_APPLETS (Track A A3): the shell runs its built-in applets by
# forking and calling the applet directly (no execve / PATH lookup / /proc/self/exe),
# so `ls`, `cp`, `grep`, … work in the terminal even before /bin is on PATH.
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_SH_NOFORK=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_BUILTIN_ECHO=y
CONFIG_ASH_BUILTIN_PRINTF=y
CONFIG_ASH_BUILTIN_TEST=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
# Don't let busybox try to be the system init / module loader.
# CONFIG_HUSH is not set

# ── musl build fix: tc needs <linux/tc_act/*> headers musl doesn't ship ───────
# CONFIG_TC is not set

# ── No MTD/UBI raw-flash on this target (sysroot lacks <mtd/mtd-user.h>) ───────
# CONFIG_NANDWRITE is not set
# CONFIG_NANDDUMP is not set
# CONFIG_FLASH_ERASEALL is not set
# CONFIG_FLASH_LOCK is not set
# CONFIG_FLASH_UNLOCK is not set
# CONFIG_FLASHCP is not set
# CONFIG_UBIATTACH is not set
# CONFIG_UBIDETACH is not set
# CONFIG_UBIMKVOL is not set
# CONFIG_UBIRMVOL is not set
# CONFIG_UBIRENAME is not set
# CONFIG_UBIUPDATEVOL is not set
# CONFIG_UBIRSVOL is not set

# ── ps/top: our processes are single-threaded, and procps_scan with SHOW_THREADS
#    dives into /proc/<pid>/task/<tid>/ and skips any pid lacking it. Without it,
#    top/ps read /proc/<pid>/stat directly (which the kernel synthesises). ──────
# CONFIG_FEATURE_SHOW_THREADS is not set

# ── No kernel modules on this microkernel ─────────────────────────────────────
# CONFIG_MODPROBE is not set
# CONFIG_INSMOD is not set
# CONFIG_RMMOD is not set
# CONFIG_LSMOD is not set
# CONFIG_DEPMOD is not set
# CONFIG_MODINFO is not set
# CONFIG_MODPROBE_SMALL is not set

# ── The OS owns init / early boot; busybox runs only as a shell + tools ───────
# CONFIG_INIT is not set
# CONFIG_LINUXRC is not set
# CONFIG_SWITCH_ROOT is not set
# CONFIG_RUN_INIT is not set
# CONFIG_MDEV is not set
