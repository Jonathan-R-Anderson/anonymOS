# BusyBox config fragment for HanonymOS
# Applied on top of an allnoconfig baseline so unspecified applets stay off.

CONFIG_STATIC=y
CONFIG_LONG_OPTS=y
# CONFIG_DEBUG is not set
CONFIG_EXTRA_CFLAGS="-O2 -pipe"
CONFIG_EXTRA_LDFLAGS="--static"

# Shell
CONFIG_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_IDLE_TIMEOUT=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_SLEEP=y
CONFIG_ASH_TEST=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_HELP=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_MATH_BASE=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_ASH=y

# Core utilities
CONFIG_CAT=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_CUT=y
CONFIG_PASTE=y
CONFIG_TR=y
CONFIG_TEE=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_FEATURE_TEST_64=y
CONFIG_YES=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_SLEEP=y
CONFIG_DATE=y
CONFIG_UNAME=y
CONFIG_HOSTNAME=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_EXPR=y
CONFIG_EXPR_MATH_SUPPORT_64=y
CONFIG_SEQ=y
CONFIG_TOUCH=y
CONFIG_STAT=y
CONFIG_MKTEMP=y
CONFIG_ENV=y
CONFIG_PRINTENV=y
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_GROUPS=y
CONFIG_LS=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_MKDIR=y
CONFIG_LN=y
CONFIG_FIND=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_XARGS=y

# Text processing
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_SORT=y
CONFIG_FEATURE_SORT_BIG=y
CONFIG_UNIQ=y
CONFIG_COMM=y
CONFIG_DIFF=y
CONFIG_PATCH=y

# Compression and archives
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_BZ2=y
CONFIG_FEATURE_SEAMLESS_XZ=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_BZIP2=y
CONFIG_BUNZIP2=y
CONFIG_BZCAT=y
CONFIG_XZ=y
CONFIG_UNXZ=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_AUTODETECT=y

# Process tools
CONFIG_PS=y
CONFIG_FEATURE_PS_WIDE=y
CONFIG_KILL=y
CONFIG_KILLALL=y

# Disk and system
CONFIG_DF=y
CONFIG_DU=y
CONFIG_DD=y
CONFIG_SYNC=y
CONFIG_DMESG=y
CONFIG_BB_SYSCTL=y

# Network
CONFIG_WGET=y
CONFIG_FEATURE_WGET_HTTPS=y
CONFIG_PING=y
CONFIG_IFCONFIG=y

# Editors and pager
CONFIG_VI=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_LESS=y
CONFIG_FEATURE_LESS_MARKS=y
CONFIG_FEATURE_LESS_REGEXP=y

# Keep heavyweight and Linux-UAPI dependent applets off.
# CONFIG_HUSH is not set
# CONFIG_INIT is not set
# CONFIG_LINUXRC is not set
# CONFIG_RUN_INIT is not set
# CONFIG_SWITCH_ROOT is not set
# CONFIG_CHVT is not set
# CONFIG_CLEAR is not set
# CONFIG_DEALLOCVT is not set
# CONFIG_DUMPKMAP is not set
# CONFIG_FGCONSOLE is not set
# CONFIG_KBD_MODE is not set
# CONFIG_LOADFONT is not set
# CONFIG_SETFONT is not set
# CONFIG_FEATURE_SETFONT_TEXTUAL_MAP is not set
# CONFIG_FEATURE_LOADFONT_PSF2 is not set
# CONFIG_FEATURE_LOADFONT_RAW is not set
# CONFIG_LOADKMAP is not set
# CONFIG_OPENVT is not set
# CONFIG_RESET is not set
# CONFIG_RESIZE is not set
# CONFIG_SETCONSOLE is not set
# CONFIG_SETKEYCODES is not set
# CONFIG_SETLOGCONS is not set
# CONFIG_SHOWKEY is not set
# CONFIG_VLOCK is not set
# CONFIG_SETPRIV is not set
# CONFIG_FEATURE_SETPRIV_DUMP is not set
# CONFIG_FEATURE_SETPRIV_CAPABILITIES is not set
# CONFIG_FEATURE_SETPRIV_CAPABILITY_NAMES is not set
# CONFIG_BEEP is not set
# CONFIG_CONSPY is not set
# CONFIG_MDEV is not set
# CONFIG_UDHCPC is not set
# CONFIG_KLOGD is not set
# CONFIG_SYSLOGD is not set
