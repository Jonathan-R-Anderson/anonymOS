	dbus-mempool.h dbus-pipe.c dbus-pipe.h dbus-string.c \
	dbus-string.h dbus-string-private.h \
	$(DBUS_SHARED_arch_sources) dbus-sysdeps.c dbus-sysdeps.h \
	dbus-valgrind-internal.h $(am__append_7)
# else they are included in the test library instead

