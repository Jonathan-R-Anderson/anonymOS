	for dir in "$(DESTDIR)$(man1dir)" "$(DESTDIR)$(docdir)" "$(DESTDIR)$(dtddir)" "$(DESTDIR)$(htmldir)" "$(DESTDIR)$(htmldir)" "$(DESTDIR)$(xmlcatalogdir)"; do \
	  test -z "$$dir" || $(MKDIR_P) "$$dir"; \
	done
