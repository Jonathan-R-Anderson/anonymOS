# deps/decoy-os/kernel/decoy-kernel.config — Kconfig fragment for the decoy's from-scratch
# Linux 6.12 kernel (roadmap/INSTALLER.md §E5d/§H1).
#
# Applied ON TOP of `make ARCH=x86_64 defconfig` (x86_64_defconfig) and then resolved with
# `make olddefconfig`; the Makefile asserts every critical CONFIG below is still =y afterward,
# so an unmet dependency that silently drops a driver fails the build instead of shipping a
# decoy that cannot find its root disk.
#
# DESIGN: the decoy's entire boot path is built =y, not =m. init-crypt (the initramfs PID 1)
# has no udev and does no modalias autoloading — it blindly insmods whatever the build put in
# /mod. Rather than reconstruct the module dependency closure (the source of the historic
# "no NVMe / no SCSI on real hardware" bug), everything needed to reach and paint the root is
# compiled in: it is simply present the moment the kernel is up. Anything left =m by defconfig
# still builds and installs into the rootfs so `lsmod`/uname look like a real 6.12 machine.

# ── clean version string: /lib/modules/6.12.x, uname -r = 6.12.x (no -dirty/+ suffix) ──
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# ── BTF: REQUIRED by argus (apps/argus) — its eBPF CO-RE loader reads /sys/kernel/btf/vmlinux
#    at load time, so without BTF argus cannot attach at all. Enabling it pulls in DWARF debug
#    info and needs `pahole` (dwarves) in the kernel build environment (added to the Dockerfile).
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
# no module signing
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_ALL is not set

# ── EFI boot: the decoy is a UKI (kernel+initramfs+cmdline in one PE) the loader StartImages ──
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# ── initramfs / early userspace ──
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ── filesystems: squashfs (compressed decoy root) + tmpfs overlay + ext4 (non-crypt variant) ──
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ── device-mapper + dm-crypt (plain aes-xts-plain64, raw hex key — no LUKS, no keyring) ──
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y

# ── crypto for aes-xts-plain64 (hardware AES-NI + generic fallback) ──
CONFIG_CRYPTO=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_SHA256=y

# ── PCI (parent of virtio-pci, ahci, nvme, xhci) ──
CONFIG_PCI=y

# ── virtio (QEMU test target: -drive if=virtio, -vga virtio) ──
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# ── SATA/AHCI + IDE (VirtualBox, real hardware, install media) ──
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y

# ── SCSI disk/CD stack (sd_mod/sr_mod, needed by ahci/usb-storage/virtio-scsi) ──
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y

# ── NVMe (modern laptops/desktops — its absence is what stranded the decoy on real HW) ──
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# ── USB host controllers + mass storage (install sticks, external disks) ──
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ── input: PS/2 (VMs) + USB HID (real keyboards/mice) + evdev (what Xorg reads) ──
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y

# ── DRM/KMS so XFCE actually paints: virtio-gpu (-vga virtio) + bochs (-vga std / VBox) ──
CONFIG_AGP=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ── console: VGA text (console=tty0) + 8250 serial (console=ttyS0, the boot-check log) ──
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ── cgroups/namespaces the OpenRC + elogind + XFCE session need ──
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# ── basic networking (NetworkManager on the decoy workstation) ──
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
