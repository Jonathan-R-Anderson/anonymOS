{
  "gateway": {
    "enabled": false,
    "probe_enabled": false,
    "listen_address": "0.0.0.0",
    "listen_port": 443,
    "public_hostname": "",
    "registration_api": "https://syndichan.org/api/v1/gateways",
    "advertise_ipv4": true,
    "advertise_ipv6": true,
    "reverse_proxy": false,
    "tls": {
      "mode": "acme",
      "acme_email": "operator@example.com",
      "acme_http_address": "0.0.0.0:80"
    },
    "external_verification": {
      "enabled": true,
      "minimum_successful_probes": 3,
