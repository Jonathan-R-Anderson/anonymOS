[Unit]
Description=Rabbiit dedicated HTTPS gateway
Documentation=https://github.com/Jonathan-R-Anderson/dendritic-node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rabbiit-node
# Neither -gateway-only nor -data-dir exists on the binary; both exit 2 with
# "flag provided but not defined". The gateway role is selected IN THE CONFIG:
#   "run_mode": "gateway-only"
# in /home/ubuntu/rabbiit-node/config/config.json (see GATEWAY.md). The data
# directory is that config file's own directory, or its data_dir key.
ExecStart=/home/ubuntu/rabbiit-node/bin/rabbiit-node -config /home/ubuntu/rabbiit-node/config/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=75s

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/rabbiit-node
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
