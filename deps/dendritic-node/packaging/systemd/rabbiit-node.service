# REFERENCE COPY. scripts/install.sh generates a better unit than this one and
# writes it to /etc/systemd/system/rabbiit-node.service: it follows the
# data_dir an existing config names in ReadWritePaths= and sets HOME for the
# service account. Prefer the installer; this file is for people who want to
# see the shape, or who are packaging by hand.
[Unit]
Description=Rabbiit encrypted volunteer storage and edge node
Documentation=https://github.com/Jonathan-R-Anderson/rabbiit/tree/main/storage-client
# No other unit to order after: the AXON overlay is built into the node, which
# fetches its seed relays over HTTPS and retries joining with backoff on its
# own. A relay node also needs its axon.listen port reachable from the internet.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rabbiit
Group=rabbiit
# The node registers exactly six flags: -config, -payout, -capacity-gib,
# -ui-listen, -show-config, -config-path. There is no -data-dir; passing it
# exits 2 with "flag provided but not defined" before anything starts. The data
# directory is the config file's own directory (config.LoadOrCreate), or the
# data_dir key inside it.
ExecStart=/usr/local/bin/rabbiit-node -config /var/lib/rabbiit/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=75s

# Only low-port binding is needed. The process does not run as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/rabbiit

[Install]
WantedBy=multi-user.target
