prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

sysconfdir=${pcfiledir}/../../etc
localstatedir=${pcfiledir}/../../var
confdir=${pcfiledir}/../../etc/fonts
cachedir=${pcfiledir}/../../var/cache/fontconfig

Name: Fontconfig
Description: Font configuration and customization library
Version: 2.15.0
Requires: freetype2 >=  21.0.15, expat
Libs: -L${libdir} -lfontconfig -pthread
Cflags: -I${includedir} -pthread
