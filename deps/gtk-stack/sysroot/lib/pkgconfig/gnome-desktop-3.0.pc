prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: gnome-desktop-3.0
Description: Utility library for loading .desktop files
Version: 44.1
Requires: gdk-pixbuf-2.0 >=  2.36.5, gtk+-3.0 >=  3.3.6, glib-2.0 >=  2.53.0, gio-2.0 >=  2.53.0, gio-unix-2.0 >=  2.53.0, gsettings-desktop-schemas >=  3.27.0, xkeyboard-config, iso-codes
Libs: -L${libdir} -lgnome-desktop-3 -lm -lrt
Cflags: -I${includedir}/gnome-desktop-3.0
