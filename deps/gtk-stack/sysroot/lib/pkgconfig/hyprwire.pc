prefix=${pcfiledir}/../..
includedir=${pcfiledir}/../../include
libdir=${pcfiledir}/../../lib

Name: hyprwire
URL: https://github.com/hyprwm/hyprwire
Description: A fast and consistent wire protocol for IPC 
Version: 0.3.1
Cflags: -I${includedir}
Libs: -L${libdir} -lhyprwire

Requires.private: hyprutils libffi
Libs.private: -lhyprutils -lffi
