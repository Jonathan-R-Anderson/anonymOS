prefix=/home/bruns/Documents/anonymOS/deps/gtk-stack/sysroot
includedir=/home/bruns/Documents/anonymOS/deps/gtk-stack/sysroot/include
libdir=/home/bruns/Documents/anonymOS/deps/gtk-stack/sysroot/lib

Name: hyprwire
URL: https://github.com/hyprwm/hyprwire
Description: A fast and consistent wire protocol for IPC 
Version: 0.3.1
