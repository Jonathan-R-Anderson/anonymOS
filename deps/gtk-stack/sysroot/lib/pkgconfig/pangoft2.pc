prefix=/home/bruns/Documents/EpinAnonymOS/deps/gtk-stack/sysroot
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Pango FT2 and Pango Fc
Description: FreeType 2.0 and fontconfig font support for Pango
Version: 1.54.0
Requires: pango, glib-2.0 >=  2.62, gobject-2.0 >=  2.62, gio-2.0 >=  2.62, fribidi >=  1.0.6, harfbuzz >=  2.6.0, fontconfig >=  2.13.0, freetype2, cairo >=  1.12.10
Libs: -L${libdir} -lpangoft2-1.0 -lm
Cflags: -I${includedir}/pango-1.0
