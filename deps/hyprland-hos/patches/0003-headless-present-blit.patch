 bool Aquamarine::CHeadlessOutput::commit() {
+    auto buffer = state->internalState.buffer;
+
+    if (buffer) {
+        if (!(buffer->caps() & BUFFER_CAPABILITY_DATAPTR)) {
+            backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: pending buffer is not CPU-readable", name));
+            return false;
