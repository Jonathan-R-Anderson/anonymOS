+
+        auto attrs                    = buffer->dmabuf();
+        auto [pixelData, fmt, bufLen] = buffer->beginDataPtr(0);
+
+        if (!pixelData || !bufLen) {
+            buffer->endDataPtr();
+            backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: pending buffer has no data pointer", name));
+            return false;
+        }
+
+        const uint32_t width  = static_cast<uint32_t>(buffer->size.x);
+        const uint32_t height = static_cast<uint32_t>(buffer->size.y);
+        const uint32_t stride = attrs.strides.at(0) ? attrs.strides.at(0) : width * 4;
+
+        SHosPresent present = {
+            .data   = reinterpret_cast<uint64_t>(pixelData),
+            .width  = width,
+            .height = height,
+            .stride = stride,
+            .format = fmt ? fmt : attrs.format,
+            .size   = static_cast<uint64_t>(bufLen),
+        };
+
+        int fd = hosPresentFD();
+        if (fd < 0 || ioctl(fd, HOS_IOCTL_PRESENT, &present) < 0) {
+            const int err = errno;
+            buffer->endDataPtr();
+            backend->backend->log(AQ_LOG_ERROR, std::format("Output {}: kernel present failed: {}", name, strerror(err)));
+            return false;
+        }
+
+        buffer->endDataPtr();
+    }
