+    // EpinAnonymOS GUI roadmap G3 — evdev bridge.
+    // The kernel exposes the QEMU/PS2 mouse as a Linux input_event stream on
+    // /dev/input/event1.  We read it directly (no libinput/libseat/udev, none of
+    // which are available in the sessionless headless backend) and translate it
+    // into aquamarine IPointer events.
+    constexpr const char* HOS_MOUSE_DEVICE = "/dev/input/event1";
+
+    // struct input_event (64-bit Linux ABI): timeval(16) + type(2) + code(2) + value(4).
+    struct SHosInputEvent {
+        uint64_t tvSec;
+        uint64_t tvUsec;
+        uint16_t type;
+        uint16_t code;
+        int32_t  value;
+    };
+    static_assert(sizeof(SHosInputEvent) == 24, "input_event ABI mismatch");
+
+    constexpr uint16_t HOS_EV_SYN     = 0x00;
+    constexpr uint16_t HOS_EV_KEY     = 0x01;
+    constexpr uint16_t HOS_EV_REL     = 0x02;
+    constexpr uint16_t HOS_SYN_REPORT = 0x00;
+    constexpr uint16_t HOS_REL_X      = 0x00;
+    constexpr uint16_t HOS_REL_Y      = 0x01;
+
+    uint32_t hosNowMs() {
+        timespec now;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        return (uint32_t)(now.tv_sec * 1000 + now.tv_nsec / 1000000);
+    }
