+
+void Aquamarine::CHeadlessBackend::dispatchInput() {
+    if (!mouseFD.isValid() || !pointer)
+        return;
+
+    SHosInputEvent ev;
+    ssize_t        ret = 0;
+    while ((ret = read(mouseFD.get(), &ev, sizeof(ev))) == sizeof(ev)) {
+        switch (ev.type) {
+            case HOS_EV_REL:
+                if (ev.code == HOS_REL_X)
+                    accumDX += ev.value;
+                else if (ev.code == HOS_REL_Y)
+                    accumDY += ev.value;
+                break;
+
+            case HOS_EV_KEY:
+                // evdev sends one EV_KEY per transition; forward the libinput
+                // button code (BTN_LEFT/RIGHT/MIDDLE) straight through.
+                pointer->events.button.emit(IPointer::SButtonEvent{
+                    .timeMs  = hosNowMs(),
+                    .button  = ev.code,
+                    .pressed = ev.value != 0,
+                });
+                break;
+
+            case HOS_EV_SYN:
+                if (ev.code != HOS_SYN_REPORT)
+                    break;
+                if (accumDX != 0 || accumDY != 0) {
+                    const Vector2D delta = {(double)accumDX, (double)accumDY};
+                    pointer->events.move.emit(IPointer::SMoveEvent{
+                        .timeMs  = hosNowMs(),
+                        .delta   = delta,
+                        .unaccel = delta,
+                    });
+                    accumDX = 0;
+                    accumDY = 0;
+                }
+                pointer->events.frame.emit();
+                break;
+
+            default: break;
+        }
+    }
 }
 
