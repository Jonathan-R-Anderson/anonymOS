+void Aquamarine::CHeadlessBackend::initInput() {
+    int fd = open(HOS_MOUSE_DEVICE, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        backend->log(AQ_LOG_ERROR, std::format("headless: no evdev pointer at {} ({}), pointer input disabled", HOS_MOUSE_DEVICE, strerror(errno)));
+        return;
+    }
+
+    mouseFD = Hyprutils::OS::CFileDescriptor{fd};
+    pointer = makeShared<CHeadlessPointer>("hos-mouse");
+
+    backend->log(AQ_LOG_DEBUG, std::format("headless: bridging kernel evdev pointer {} -> aquamarine pointer", HOS_MOUSE_DEVICE));
+
+    // Announce the pointer once the event loop is running, mirroring how the
+    // wayland backend defers newPointer through an idle callback so Hyprland's
+    // input manager is already listening.
+    auto announce = makeShared<std::function<void(void)>>([this]() {
+        if (pointer)
+            backend->events.newPointer.emit(SP<IPointer>(pointer));
+    });
+    backend->addIdleEvent(announce);
+}
