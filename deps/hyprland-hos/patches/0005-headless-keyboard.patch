+void Aquamarine::CHeadlessBackend::dispatchKeyboard() {
+    if (!kbdFD.isValid() || !keyboard)
+        return;
+
+    SHosInputEvent ev;
+    while (read(kbdFD.get(), &ev, sizeof(ev)) == sizeof(ev)) {
+        if (ev.type != HOS_EV_KEY)
+            continue; // ignore EV_SYN/EV_MSC; Hyprland tracks repeat itself
+        // ev.code is the evdev keycode; Hyprland adds the +8 xkb offset and
+        // derives modifiers from its own keymap.
+        keyboard->events.key.emit(IKeyboard::SKeyEvent{
+            .timeMs  = hosNowMs(),
+            .key     = ev.code,
+            .pressed = ev.value != 0,
+        });
+    }
+}
