+std::chrono::nanoseconds Aquamarine::CHeadlessOutput::frameInterval() {
+    int64_t refreshRatemHz = 60000;
+    auto&   currentState   = state->state();
+
+    if (currentState.mode)
+        refreshRatemHz = currentState.mode->refreshRate;
+    else if (currentState.customMode)
+        refreshRatemHz = currentState.customMode->refreshRate;
+
+    if (refreshRatemHz < 24000)
+        refreshRatemHz = 60000;
+    else if (refreshRatemHz > 240000)
+        refreshRatemHz = 240000;
+
+    return std::chrono::nanoseconds(1000LL * TIMESPEC_NSEC_PER_SEC / refreshRatemHz);
+}
+
+void Aquamarine::CHeadlessOutput::emitFrame(const char* source) {
+    frameScheduled = false;
+    ++frameSequence;
+    lastFrame = std::chrono::steady_clock::now();
+    backend->backend->log(AQ_LOG_DEBUG, std::format("G8 frame {} begin source={} needsFrame={}", frameSequence, source, needsFrame));
+    events.frame.emit();
+
+    if (needsFrame || activeRepaintTicks > 0)
+        armRepaintWatchdog();
+}
+
+void Aquamarine::CHeadlessOutput::armRepaintWatchdog() {
+    if (watchdogScheduled)
+        return;
+
+    watchdogScheduled = true;
+
+    auto       watchdogInterval = frameInterval();
+    const auto minWatchdogInterval = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::milliseconds(33));
+    if (watchdogInterval < minWatchdogInterval)
+        watchdogInterval = minWatchdogInterval;
+
+    backend->addTimer(std::chrono::steady_clock::now() + watchdogInterval, [this, weak = self]() {
+        if (!weak)
+            return;
+
+        watchdogScheduled = false;
+
+        if (activeRepaintTicks > 0)
+            --activeRepaintTicks;
+
+        if (!needsFrame && !frameScheduled && activeRepaintTicks == 0)
+            return;
+
+        if (!frameScheduled) {
+            backend->backend->log(AQ_LOG_DEBUG,
+                                  std::format("G8 watchdog scheduling repaint needsFrame={} active_ticks={}", needsFrame, activeRepaintTicks));
+            scheduleFrame(IOutput::AQ_SCHEDULE_NEEDS_FRAME);
+            return;
+        }
+
+        if (needsFrame || activeRepaintTicks > 0)
+            armRepaintWatchdog();
+    });
+}
