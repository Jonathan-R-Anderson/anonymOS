+void Aquamarine::CHeadlessBackend::scheduleOutputs(IOutput::scheduleFrameReason reason) {
+    size_t scheduled = 0;
+    for (auto* const output : g_hosHeadlessOutputs) {
+        if (!output)
+            continue;
+
+        output->needsFrame = true;
+        output->activeRepaintTicks = std::max(output->activeRepaintTicks, 18U);
+        output->armRepaintWatchdog();
+        output->frameScheduled = false;
+        output->scheduleFrame(reason);
+
+        ++scheduled;
+    }
+
+    if (scheduled > 0)
+        backend->log(AQ_LOG_DEBUG, std::format("G8 input scheduled {} output repaint(s)", scheduled));
+}
