+            }
+            return applyWlrOutputConfig(rule);
+        }
     }
 
     Log::logger->log(Log::WARN, "No rules configured. Using the default hardcoded one.");
@@ -99,6 +107,11 @@ CMonitorRule CMonitorRuleManager::get(const PHLMONITOR PMONITOR) {
