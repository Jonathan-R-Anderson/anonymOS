# Minimal wpa_supplicant for EpinAnonymOS: nl80211 + libnl-tiny + internal crypto + poll eloop.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL_TINY=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_ELOOP_POLL=y
CONFIG_L2_PACKET=linux
CONFIG_IEEE8021X_EAPOL=y
CONFIG_WPA_CLI_EDIT=y
CONFIG_DEBUG_FILE=y
