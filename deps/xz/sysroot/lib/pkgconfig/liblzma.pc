prefix=/home/bruns/Documents/EpinAnonymOS/deps/xz/sysroot
exec_prefix=/home/bruns/Documents/EpinAnonymOS/deps/xz/sysroot
libdir=/home/bruns/Documents/EpinAnonymOS/deps/xz/sysroot/lib
includedir=/home/bruns/Documents/EpinAnonymOS/deps/xz/sysroot/include

Name: liblzma
Description: General purpose data compression library
URL: https://xz.tukaani.org/xz-utils/
Version: 5.4.6
Cflags: -I${includedir}
Cflags.private: -DLZMA_API_STATIC
Libs: -L${libdir} -llzma
Libs.private: -pthread -lpthread
