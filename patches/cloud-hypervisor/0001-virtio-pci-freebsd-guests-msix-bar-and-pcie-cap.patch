+// anonymOS: a minimal PCI Express capability (version 1 -- 20 bytes, all that fits beside the
+// virtio capabilities -- Root Complex Integrated Endpoint; no link).  FreeBSD enables MSI/MSI-X only on a PCI Express (or PCI-X) chipset or a whitelisted VM
+// host bridge (pci_msi_blacklisted()), and it decides "PCI Express chipset" from any device
+// carrying this capability -- without it every interrupt allocation for a virtio device fails
+// ("exhausted all interrupt allocation attempts").  Linux guests read it as an RCiEP.
+struct PcieRcepCap {
+    body: [u8; 0x12],
+}
+
+impl PcieRcepCap {
+    fn new() -> Self {
+        let mut body = [0u8; 0x12];
+        body[0] = 0x91; // PCI Express Capabilities: version 1, device/port type 9 (RCiEP)
+        PcieRcepCap { body }
+    }
+}
+
+impl PciCapability for PcieRcepCap {
+    fn bytes(&self) -> &[u8] {
+        &self.body
+    }
+
+    fn id(&self) -> PciCapabilityId {
+        PciCapabilityId::PciExpress
+    }
+}
