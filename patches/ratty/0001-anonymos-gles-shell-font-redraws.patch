+/// Bevy's default log filter, minus wgpu-hal's GL texture-target heuristic
+/// notice: on the GLES backend it fires on every bind group that holds one of
+/// Bevy's (unused, shadow maps are off) array or cube-array shadow textures,
+/// i.e. twice a frame. The GL backend's device, queue and EGL messages stay.
+fn log_filter() -> String {
+    format!(
+        "{},wgpu_hal::gles=off,wgpu_hal::gles::device=warn,\
+         wgpu_hal::gles::queue=warn,wgpu_hal::gles::command=warn,\
+         wgpu_hal::gles::egl=warn,wgpu_hal::gles::adapter=warn",
+        DEFAULT_FILTER.trim_end_matches(',')
+    )
+}
+
+/// Hands winit's display connection to the renderer before it is created.
+///
+/// wgpu's GLES backend has to create its EGL display against the same Wayland
+/// (or X11) connection the window lives on; created without it, EGL is
+/// surfaceless and cannot present to the window. This is what lets Ratty run
+/// on OpenGL ES (e.g. Mesa llvmpipe) where no Vulkan driver exists.
+struct PlatformDisplayPlugin;
+
+impl Plugin for PlatformDisplayPlugin {
+    fn build(&self, app: &mut App) {
+        let display = app
+            .world()
+            .get_resource::<bevy::winit::DisplayHandleWrapper>()
+            .map(|wrapper| wrapper.0.clone());
+        if let Some(display) = display {
+            app.insert_resource(RenderDisplayHandle(std::sync::Arc::new(display)));
+        }
+    }
+}
+
+/// With `update_mode = "Auto"`, caps redraws on a software rasterizer.
+///
+/// A CPU adapter (Mesa llvmpipe/softpipe, e.g. in a VM without 3D) spends
+/// every frame rasterizing the whole window, so updating continuously pins
+/// the CPU even while the terminal is idle. There, both focused and unfocused
+/// windows update reactively instead: at once on input, window events and PTY
+/// output, and otherwise every `software_frame_interval_ms` (animations).
+fn cap_software_redraws(
+    app_config: Res<AppConfig>,
+    adapter: Option<Res<bevy::render::renderer::RenderAdapterInfo>>,
+    mut winit_settings: ResMut<WinitSettings>,
+) {
+    let Some(adapter) = adapter else {
+        return;
+    };
+    if !matches!(app_config.window.update_mode, UpdateModeConfig::Auto)
+        || adapter.device_type != wgpu::DeviceType::Cpu
+    {
+        return;
+    }
+    info!(
+        "software renderer ({}): redrawing on input and output, at least every {} ms",
+        adapter.name,
+        app_config.window.software_frame_interval_ms.max(1)
+    );
+    *winit_settings = reactive_settings(app_config.window.software_frame_interval_ms);
+}
+
+/// Updates on input, window events and PTY output, and at least every
+/// `frame_interval_ms` (which paces animations such as the cursor model).
+fn reactive_settings(frame_interval_ms: u64) -> WinitSettings {
+    let interval = Duration::from_millis(frame_interval_ms.max(1));
+    WinitSettings {
+        focused_mode: UpdateMode::reactive_low_power(interval),
+        unfocused_mode: UpdateMode::reactive_low_power(interval),
+    }
+}
+
+/// Wakes the winit event loop whenever the PTY produces output, so a reactive
+/// update mode shows it at once rather than on the next timed update.
+fn wake_on_pty_output(runtime: Res<TerminalRuntime>, proxy: Res<EventLoopProxyWrapper>) {
+    let proxy = std::sync::Mutex::new((**proxy).clone());
+    runtime.set_output_waker(move || {
+        if let Ok(proxy) = proxy.lock() {
+            let _ = proxy.send_event(WinitUserEvent::WakeUp);
+        }
+    });
+}
