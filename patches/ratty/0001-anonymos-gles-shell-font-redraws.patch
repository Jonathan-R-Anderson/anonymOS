+    #[cfg(unix)]
+    {
+        std::ffi::CString::new(path)
+            .is_ok_and(|path| unsafe { libc::access(path.as_ptr(), libc::X_OK) } == 0)
+    }
+    #[cfg(not(unix))]
+    {
+        std::path::Path::new(path).is_file()
+    }
+}
