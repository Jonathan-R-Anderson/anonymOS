+/// The default font family.
+pub const DEFAULT_FONT_FAMILY: &str = "DejaVu Sans Mono";
+
+/// Environment variable naming the system's terminal font file (set by anonymOS).
+pub const SYSTEM_TERMINAL_FONT_ENV: &str = "HOS_TERMINAL_FONT";
+
+impl FontConfig {
+    /// Uses the system's terminal font file when the font is still the default
+    /// family and no font files are configured.
+    ///
+    /// anonymOS names its terminal font in `HOS_TERMINAL_FONT` (a monospace
+    /// `*-Regular.ttf`) and ships no DejaVu; a sibling `*-Bold.ttf` is used for
+    /// bold when present. Nothing changes when the variable is unset or the file
+    /// is missing.
+    pub fn prefer_system_terminal_font(&mut self) {
+        let explicit = [&self.regular, &self.bold, &self.italic, &self.bold_italic];
+        if self.family != DEFAULT_FONT_FAMILY || explicit.iter().any(|face| face.is_some()) {
+            return;
+        }
+        let Some(regular) = std::env::var_os(SYSTEM_TERMINAL_FONT_ENV).map(PathBuf::from) else {
+            return;
+        };
+        if !regular.is_file() {
+            return;
+        }
+        let bold = regular
+            .file_name()
+            .and_then(|name| name.to_str())
+            .filter(|name| name.contains("-Regular."))
+            .map(|name| regular.with_file_name(name.replacen("-Regular.", "-Bold.", 1)))
+            .filter(|bold| bold.is_file());
+        self.regular = Some(regular);
+        self.bold = bold;
+    }
+}
