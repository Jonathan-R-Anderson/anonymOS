+            cmd.env("SHELL", &self.program);
+            cmd
+        } else {
+            CommandBuilder::new(&self.program)
+        };
+        cmd.env("SHELL", &self.program);
+        if let Some(flavor) = self.flavor {
+            cmd.env("EPIN_SHELL", flavor);
+        }
+        cmd
+    }
