+/// The platform display connection (e.g. the Wayland `wl_display`) that the wgpu
+/// [`Instance`] is created against.
+///
+/// wgpu's GLES backend needs the display at *instance* creation to present to a Wayland
+/// (or X11) window: without it EGL falls back to the surfaceless platform and every window
+/// surface is rejected ("incompatible window kind").  Vulkan, Metal and DX12 ignore it.
+/// Insert it as a resource before [`RenderPlugin`](crate::RenderPlugin) is built, e.g. from
+/// `bevy_winit`'s `DisplayHandleWrapper` (the event loop's owned display handle).
+#[derive(Resource, Clone, Debug)]
+pub struct RenderDisplayHandle(pub Arc<dyn wgpu::wgt::WgpuHasDisplayHandle>);
+
+impl wgpu::rwh::HasDisplayHandle for RenderDisplayHandle {
+    fn display_handle(&self) -> Result<wgpu::rwh::DisplayHandle<'_>, wgpu::rwh::HandleError> {
+        self.0.display_handle()
+    }
+}
