+/// Like [`initialize_renderer`], but creates the wgpu [`Instance`] against `display`
+/// (see [`RenderDisplayHandle`]).
+pub async fn initialize_renderer_with_display(
+    backends: Backends,
+    primary_window: Option<RawHandleWrapperHolder>,
+    display: Option<RenderDisplayHandle>,
+    options: &WgpuSettings,
+    #[cfg(feature = "raw_vulkan_init")]
+    raw_vulkan_init_settings: raw_vulkan_init::RawVulkanInitSettings,
 ) -> RenderResources {
     let instance_descriptor = wgpu::InstanceDescriptor {
         backends,
         flags: options.instance_flags,
         memory_budget_thresholds: options.instance_memory_budget_thresholds,
-        display: None,
+        display: display
+            .map(|display| Box::new(display) as Box<dyn wgpu::wgt::WgpuHasDisplayHandle>),
         backend_options: wgpu::BackendOptions {
             gl: wgpu::GlBackendOptions {
                 gles_minor_version: options.gles3_minor_version,
@@ -327,6 +366,15 @@ pub async fn initialize_renderer(
         limits = limits.or_worse_values_from(constrained_limits);
     }
 
+    // On the GL backend, keep the passes that need 5+ storage textures (SSAO) off: naga's GLSL
+    // output for SSAO's depth prepass gathers from a depth texture through a shadow sampler
+    // (`textureGatherOffset(sampler2DShadow, vec2, ivec2, int)`), which no GLSL version accepts,
+    // so creating that pipeline fails at startup and takes the whole renderer down with it.
+    if adapter_info.backend == wgpu::Backend::Gl {
+        limits.max_storage_textures_per_shader_stage =
+            limits.max_storage_textures_per_shader_stage.min(4);
+    }
+
     let device_descriptor = wgpu::DeviceDescriptor {
         label: options.device_label.as_ref().map(AsRef::as_ref),
         required_features: features,
