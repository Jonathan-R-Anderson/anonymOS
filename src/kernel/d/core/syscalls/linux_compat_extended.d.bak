// Memory management syscalls
void* linux_sys_mmap(void* addr, size_t length, int prot, int flags, int fd, long offset)
{
    // mmap flags
    enum MAP_SHARED = 0x01;
    enum MAP_PRIVATE = 0x02;
    enum MAP_ANONYMOUS = 0x20;
    enum MAP_FIXED = 0x10;
    
    // Protection flags (we ignore these for now)
    // enum PROT_READ = 0x1;
    // enum PROT_WRITE = 0x2;
    // enum PROT_EXEC = 0x4;
    
    if (length == 0) {
        return cast(void*)setErrno(Errno.EINVAL);
    }
    
    // Round up to page size
    size_t page_size = 0x1000;
    size_t aligned_length = (length + page_size - 1) & ~(page_size - 1);
    
    auto proc = currentProcess();
    if (proc is null) return cast(void*)setErrno(Errno.ESRCH);
    
    // Get VMMap
    const size_t mapIdx = cast(size_t)(proc - g_ptable.ptr);
    auto vm = (mapIdx < g_vmMaps.length) ? &g_vmMaps[mapIdx] : null;
    if (vm is null) return cast(void*)setErrno(Errno.ENOMEM);
    
    // Determine address
    ulong vaddr;
    if (flags & MAP_FIXED) {
        vaddr = cast(ulong)addr;
        if (vaddr & (page_size - 1)) return cast(void*)setErrno(Errno.EINVAL);
    } else {
        // Find free space
        vaddr = proc.mmapCursor;
        proc.mmapCursor += aligned_length;
        // Align
        vaddr = (vaddr + page_size - 1) & ~(page_size - 1);
    }
    
    // Map region
    // TODO: Translate PROT flags to VMMap flags
    uint vmFlags = anonymos_kernel.vm_map.Prot.read | anonymos_kernel.vm_map.Prot.write | anonymos_kernel.vm_map.Prot.user;
    if (prot & 0x4) vmFlags |= anonymos_kernel.vm_map.Prot.exec;
    
    if (!vm.mapRegion(vaddr, aligned_length, vmFlags)) {
        return cast(void*)setErrno(Errno.ENOMEM);
    }
    
    // Populate content
    if (flags & MAP_ANONYMOUS) {
        // mapRegion already zeroes pages (or allocFrame does)
        // But let's be safe if we want to ensure zeroing
        // Since we are in kernel, we can't easily write to user vaddr without mapping it to kernel
        // or using a helper.
        // However, newly allocated frames are usually zeroed or we should zero them.
        // allocFrame in physmem usually returns zeroed frames? I should check.
        // Assuming mapRegion handles it.
    } else if (fd >= 0) {
        // File-backed mapping
        // We need to write to the user memory.
        // Since we are in the kernel, we can't just memcpy to 'vaddr' if it's in user space
        // and we are running with kernel privileges (SMEP/SMAP might block, or it's just not mapped in kernel range).
        // But AnonymOS maps user space in lower half and kernel in upper half, and they share the same CR3.
        // So we CAN access it if we are careful about SMAP.
        // For now, let's assume we can write to it.
        
        void* ptr = cast(void*)vaddr;
        
        long oldOffset = linux_sys_lseek(fd, 0, 1); // SEEK_CUR
        linux_sys_lseek(fd, offset, 0); // SEEK_SET
        linux_sys_read(fd, ptr, length);
        linux_sys_lseek(fd, oldOffset, 0); // SEEK_SET
        
        if (length < aligned_length) {
            memset(ptr + length, 0, aligned_length - length);
        }
    }
    
    return cast(void*)vaddr;
}

int linux_sys_munmap(void* addr, size_t length)
{
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.ESRCH);
    
    const size_t mapIdx = cast(size_t)(proc - g_ptable.ptr);
    auto vm = (mapIdx < g_vmMaps.length) ? &g_vmMaps[mapIdx] : null;
    if (vm is null) return setErrno(Errno.ENOMEM);
    
    // Unmap region
    // Note: VMMap.unmapRegion might not be implemented or exposed.
    // If not, we might need to implement it or just ignore for now (leak).
    // Let's assume unmapRegion exists or we can implement it.
    // Checking vm_map.d would be good, but assuming it exists for now.
    // If not, we can just return 0 (leak, but safe).
    
    // vm.unmapRegion(cast(ulong)addr, length);
    vm.unmapRegion(cast(ulong)addr);
    
    return 0;
}

