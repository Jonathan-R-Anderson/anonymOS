// File descriptor operations
int linux_sys_dup(int oldfd)
{
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.ESRCH);
    
    if (oldfd < 0 || oldfd >= MAX_FD || proc.fds[oldfd].num == -1) {
        return setErrno(Errno.EBADF);
    }
    
    int newfd = allocFd();
    if (newfd < 0) return setErrno(Errno.EMFILE);
    
    // Copy FD
    proc.fds[newfd] = proc.fds[oldfd];
    proc.fds[newfd].num = newfd;
    
    return newfd;
}

int linux_sys_dup2(int oldfd, int newfd)
{
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.ESRCH);
    
    if (oldfd < 0 || oldfd >= MAX_FD || proc.fds[oldfd].num == -1) {
        return setErrno(Errno.EBADF);
    }
    
    if (newfd < 0 || newfd >= MAX_FD) {
        return setErrno(Errno.EBADF);
    }
    
    if (oldfd == newfd) return newfd;
    
    // Close newfd if it's open
    if (proc.fds[newfd].num != -1) {
        linux_sys_close(newfd);
    }
    
    // Copy FD
    proc.fds[newfd] = proc.fds[oldfd];
    proc.fds[newfd].num = newfd;
    
    return newfd;
}

int linux_sys_pipe2(int* pipefd, int flags)
{
    if (pipefd is null) return setErrno(Errno.EFAULT);
    
    ObjectID pipeId = createPipe();
    if (pipeId.low == 0) return setErrno(Errno.ENOMEM);
    
    int rfd = allocFd();
    if (rfd < 0) return setErrno(Errno.EMFILE);
    
    int wfd = allocFd();
    if (wfd < 0) {
        // TODO: Free rfd
        return setErrno(Errno.EMFILE);
    }
    
    auto proc = currentProcess();
    proc.fds[rfd].cap = Capability(pipeId, Rights.Read);
    proc.fds[wfd].cap = Capability(pipeId, Rights.Write);
    
    pipefd[0] = rfd;
    pipefd[1] = wfd;
    
    return 0;
}

int linux_sys_pipe(int* pipefd)
{
    return linux_sys_pipe2(pipefd, 0);
}

// I/O multiplexing
struct pollfd {
    int fd;
    short events;
    short revents;
}

int linux_sys_poll(void* fds, uint nfds, int timeout)
{
    if (fds is null && nfds > 0) {
        return setErrno(Errno.EFAULT);
    }
    
    auto pollfds = cast(pollfd*)fds;
    int ready = 0;
    auto proc = currentProcess();
    
    // Simple implementation: check status immediately
    // If timeout > 0 and nothing ready, we should sleep (not implemented fully)
    
    for (uint i = 0; i < nfds; ++i)
    {
        pollfds[i].revents = 0;
        if (pollfds[i].fd < 0) continue;
        
        if (pollfds[i].fd >= MAX_FD || proc.fds[pollfds[i].fd].num == -1)
        {
            pollfds[i].revents = 32; // POLLNVAL
            ready++;
            continue;
        }
        
        // Check readiness (simplified)
        // Assume always ready for now
        short mask = 0;
        if (pollfds[i].events & 0x001) mask |= 0x001; // POLLIN
        if (pollfds[i].events & 0x004) mask |= 0x004; // POLLOUT
        
        if (mask != 0)
        {
            pollfds[i].revents = mask;
            ready++;
        }
    }
    
    if (ready == 0 && timeout != 0)
    {
        schedYield();
    }
    
    return ready;
}

int linux_sys_select(int nfds, void* readfds, void* writefds, void* exceptfds, void* timeout)
{
    if (nfds < 0) return setErrno(Errno.EINVAL);
    
    // Bit manipulation helpers
    static bool isSet(void* set, int fd) {
        if (set is null) return false;
        return ((cast(ulong*)set)[fd / 64] & (1UL << (fd % 64))) != 0;
    }
    
    static void clearSet(void* set, int fd) {
        if (set is null) return;
        (cast(ulong*)set)[fd / 64] &= ~(1UL << (fd % 64));
    }
    
    static void setBit(void* set, int fd) {
        if (set is null) return;
        (cast(ulong*)set)[fd / 64] |= (1UL << (fd % 64));
    }
    
    int ready = 0;
    auto proc = currentProcess();
    
    // Scan FDs
    for (int fd = 0; fd < nfds; ++fd)
    {
        bool r = isSet(readfds, fd);
        bool w = isSet(writefds, fd);
        bool e = isSet(exceptfds, fd);
        
        if (!r && !w && !e) continue;
        
        if (fd >= MAX_FD || proc.fds[fd].num == -1)
        {
            return setErrno(Errno.EBADF);
        }
        
        // Check readiness (simplified: always ready)
        bool readyR = true;
        bool readyW = true;
        bool readyE = false;
        
        if (r && !readyR) clearSet(readfds, fd);
        if (w && !readyW) clearSet(writefds, fd);
        if (e && !readyE) clearSet(exceptfds, fd);
        
        if ((r && readyR) || (w && readyW) || (e && readyE)) ready++;
    }
    
    if (ready == 0 && timeout !is null)
    {
        schedYield();
    }
    
    return ready;
}

// Epoll structures
struct epoll_event {
    uint events;
    ulong data;
}

struct EpollEntry {
    int fd;
    epoll_event event;
    EpollEntry* next;
}

// Epoll event flags
enum EPOLLIN = 0x001;
enum EPOLLPRI = 0x002;
enum EPOLLOUT = 0x004;
enum EPOLLERR = 0x008;
enum EPOLLHUP = 0x010;
enum EPOLLRDHUP = 0x2000;
enum EPOLLONESHOT = 1u << 30;
enum EPOLLET = 1u << 31;

// Epoll control ops
enum EPOLL_CTL_ADD = 1;
enum EPOLL_CTL_DEL = 2;
enum EPOLL_CTL_MOD = 3;

int linux_sys_epoll_create(int size)
{
    return linux_sys_epoll_create1(0);
}

int linux_sys_epoll_create1(int flags)
{
    ObjectID epollId = createEpoll();
    if (epollId.low == 0) return setErrno(Errno.ENOMEM);
    
    int fd = allocFd();
    if (fd < 0) return setErrno(Errno.EMFILE);
    
    auto proc = currentProcess();
    proc.fds[fd].cap = Capability(epollId, Rights.Read | Rights.Write);
    
    return fd;
}

int linux_sys_epoll_ctl(int epfd, int op, int fd, epoll_event* event)
{
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.EINVAL);
    
    if (epfd < 0 || epfd >= MAX_FD) return setErrno(Errno.EBADF);
    if (proc.fds[epfd].num == -1) return setErrno(Errno.EBADF);
    
    Capability cap = proc.fds[epfd].cap;
    auto slot = getObject(cap.oid);
    if (slot is null || slot.type != ObjectType.Epoll) return setErrno(Errno.EINVAL);
    
    if (op == EPOLL_CTL_DEL)
    {
        // Remove from list
        EpollEntry** curr = cast(EpollEntry**)&slot.epoll.eventList;
        while (*curr !is null)
        {
            if ((*curr).fd == fd)
            {
                auto toFree = *curr;
                *curr = (*curr).next;
                kfree(toFree);
                slot.epoll.count--;
                return 0;
            }
            curr = &(*curr).next;
        }
        return setErrno(Errno.ENOENT);
    }
    else if (op == EPOLL_CTL_ADD)
    {
        // Check if already exists
        EpollEntry* curr = cast(EpollEntry*)slot.epoll.eventList;
        while (curr !is null)
        {
            if (curr.fd == fd) return setErrno(Errno.EEXIST);
            curr = curr.next;
        }
        
        // Add new entry
        auto newEntry = cast(EpollEntry*)kmalloc(EpollEntry.sizeof);
        if (newEntry is null) return setErrno(Errno.ENOMEM);
        
        newEntry.fd = fd;
        if (event !is null) newEntry.event = *event;
        newEntry.next = cast(EpollEntry*)slot.epoll.eventList;
        slot.epoll.eventList = newEntry;
        slot.epoll.count++;
        return 0;
    }
    else if (op == EPOLL_CTL_MOD)
    {
        // Modify existing
        EpollEntry* curr = cast(EpollEntry*)slot.epoll.eventList;
        while (curr !is null)
        {
            if (curr.fd == fd)
            {
                if (event !is null) curr.event = *event;
                return 0;
            }
            curr = curr.next;
        }
        return setErrno(Errno.ENOENT);
    }
    
    return setErrno(Errno.EINVAL);
}

int linux_sys_epoll_wait(int epfd, epoll_event* events, int maxevents, int timeout)
{
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.EINVAL);
    
    if (epfd < 0 || epfd >= MAX_FD) return setErrno(Errno.EBADF);
    if (proc.fds[epfd].num == -1) return setErrno(Errno.EBADF);
    
    Capability cap = proc.fds[epfd].cap;
    auto slot = getObject(cap.oid);
    if (slot is null || slot.type != ObjectType.Epoll) return setErrno(Errno.EINVAL);
    
    if (maxevents <= 0 || events is null) return setErrno(Errno.EINVAL);
    
    // For now, implement non-blocking check
    // In a real implementation, we would sleep if no events are ready and timeout > 0
    
    int count = 0;
    EpollEntry* curr = cast(EpollEntry*)slot.epoll.eventList;
    
    while (curr !is null && count < maxevents)
    {
        // Check if FD is ready
        // This requires checking the actual object backing the FD
        // For now, assume always ready for read/write if requested
        
        int readyMask = 0;
        
        // Look up the FD in the process
        if (curr.fd >= 0 && curr.fd < MAX_FD && proc.fds[curr.fd].num != -1)
        {
             // Check object type
             Capability targetCap = proc.fds[curr.fd].cap;
             auto targetSlot = getObject(targetCap.oid);
             
             if (targetSlot !is null)
             {
                 // Logic to check readiness
                 // For sockets/pipes, check buffer status
                 // For files, always ready
                 
                 // Simplified:
                 readyMask = EPOLLIN | EPOLLOUT; 
             }
        }
        
        if (readyMask & curr.event.events)
        {
            events[count].events = readyMask & curr.event.events;
            events[count].data = curr.event.data;
            count++;
        }
        
        curr = curr.next;
    }
    
    if (count == 0 && timeout != 0)
    {
        // If timeout > 0, we should sleep.
        // For now, just yield once to be polite
        schedYield();
        // Return 0 (timeout)
    }
    
    return count;
}

// File operations
long linux_sys_lseek(int fd, long offset, int whence)
{
    enum SEEK_SET = 0;
    enum SEEK_CUR = 1;
    enum SEEK_END = 2;
    
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.ESRCH);
    
    if (fd < 0 || fd >= MAX_FD) return setErrno(Errno.EBADF);
    if (proc.fds[fd].num == -1) return setErrno(Errno.EBADF);
    
    // Get file size for SEEK_END
    // Get file size for SEEK_END
    long fileSize = 0;
    Capability cap = proc.fds[fd].cap;
    auto slot = getObject(cap.oid);
    
    if (slot is null) return setErrno(Errno.EBADF);
    
    // Only Blobs (files) are seekable
    if (slot.type != ObjectType.Blob) return setErrno(Errno.ESPIPE);
    
    fileSize = cast(long)slot.blob.size;
    
    long newOffset = proc.fds[fd].offset;
    
    switch (whence)
    {
        case SEEK_SET: newOffset = offset; break;
        case SEEK_CUR: newOffset += offset; break;
        case SEEK_END: newOffset = fileSize + offset; break;
        default: return setErrno(Errno.EINVAL);
    }
    
    if (newOffset < 0) return setErrno(Errno.EINVAL);
    
    proc.fds[fd].offset = newOffset;
    return newOffset;
}

long linux_sys_pread64(int fd, void* buf, size_t count, long offset)
{
    // Positional read - read at offset without changing file position
    if (buf is null) {
        return setErrno(Errno.EFAULT);
    }
    
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.ESRCH);
    
    if (fd < 0 || fd >= MAX_FD || proc.fds[fd].num == -1) {
        return setErrno(Errno.EBADF);
    }
    
    Capability cap = proc.fds[fd].cap;
    auto slot = getObject(cap.oid);
    if (slot is null) return setErrno(Errno.EBADF);
    
    // Only supported on seekable files (Blobs)
    if (slot.type == ObjectType.Blob)
    {
        return blobRead(cap.oid, cast(ulong)offset, count, cast(ubyte*)buf);
    }
    
    return setErrno(Errno.ESPIPE);
}

long linux_sys_pwrite64(int fd, const(void)* buf, size_t count, long offset)
{
    // Positional write - write at offset without changing file position
    if (buf is null) {
        return setErrno(Errno.EFAULT);
    }
    
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.ESRCH);
    
    if (fd < 0 || fd >= MAX_FD || proc.fds[fd].num == -1) {
        return setErrno(Errno.EBADF);
    }
    
    Capability cap = proc.fds[fd].cap;
    auto slot = getObject(cap.oid);
    if (slot is null) return setErrno(Errno.EBADF);
    
    // Only supported on seekable files (Blobs)
    if (slot.type == ObjectType.Blob)
    {
        return blobWrite(cap.oid, cast(ulong)offset, cast(const(ubyte)*)buf, count);
    }
    
    return setErrno(Errno.ESPIPE);
}

long linux_sys_readv(int fd, const(iovec)* iov, int iovcnt)
{
    // Vectored read - read into multiple buffers
    if (iov is null || iovcnt <= 0) {
        return setErrno(Errno.EINVAL);
    }
    
    long total = 0;
    for (int i = 0; i < iovcnt; i++) {
        if (iov[i].iov_base is null || iov[i].iov_len == 0) {
            continue;
        }
        
        long n = linux_sys_read(fd, cast(void*)iov[i].iov_base, iov[i].iov_len);
        if (n < 0) {
            return n; // Error
        }
        
        total += n;
        
        // If we read less than requested, stop
        if (n < iov[i].iov_len) {
            break;
        }
    }
    
    return total;
}

long linux_sys_writev(int fd, const(iovec)* iov, int iovcnt)
{
    // Vectored write - write from multiple buffers
    if (iov is null || iovcnt <= 0) {
        return setErrno(Errno.EINVAL);
    }
    
    long total = 0;
    for (int i = 0; i < iovcnt; i++) {
        if (iov[i].iov_base is null || iov[i].iov_len == 0) {
            continue;
        }
        
        long n = linux_sys_write(fd, iov[i].iov_base, iov[i].iov_len);
        if (n < 0) {
            return n; // Error
        }
        
        total += n;
        
        // If we wrote less than requested, stop
        if (n < iov[i].iov_len) {
            break;
        }
    }
    
    return total;
}

