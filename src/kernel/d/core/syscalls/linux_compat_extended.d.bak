int linux_sys_sched_getaffinity(int pid, size_t cpusetsize, void* mask)
{
    // Get CPU affinity mask
    // Shows which CPUs a process can run on
    if (mask is null || cpusetsize == 0) {
        return setErrno(Errno.EINVAL);
    }
    
    // Say all CPUs are available
    import core.stdc.string : memset;
    memset(mask, 0xFF, cpusetsize);
    
    return 0;
}

