// File metadata
int linux_sys_access(const(char)* pathname, int mode)
{
    // Check file access permissions
    // Modes: F_OK (existence), R_OK, W_OK, X_OK
    
    if (pathname is null) return setErrno(Errno.EFAULT);
    
    auto proc = currentProcess();
    if (proc is null) return setErrno(Errno.ESRCH);
    
    size_t len = 0;
    while (pathname[len] != 0) len++;
    const(char)[] pathStr = pathname[0..len];
    
    Capability startCap = Capability(proc.cwd, Rights.Read | Rights.Execute);
    if (len > 0 && pathname[0] == '/') startCap = proc.rootCap;
    
    Capability target = resolvePath(startCap.oid, pathStr);
    if (target.oid.low == 0) return setErrno(Errno.ENOENT);
    
    if (mode == 0) return 0; // F_OK
    
    // TODO: Check rights
    return 0;
}


int linux_sys_faccessat(int dirfd, const(char)* pathname, int mode, int flags)
{
    // Access check relative to directory FD
    if (pathname is null) {
        return setErrno(Errno.EFAULT);
    }
    
    // Delegate to access for now
    return linux_sys_access(pathname, mode);
}

long linux_sys_readlink(const(char)* pathname, char* buf, size_t bufsiz)
{
    // Read symbolic link target
    // Requires symlink support in filesystem
    if (pathname is null || buf is null) {
        return setErrno(Errno.EFAULT);
    }
    
    if (bufsiz == 0) {
        return setErrno(Errno.EINVAL);
    }
    
    // Would read symlink target here
    return setErrno(Errno.EINVAL); // Not a symlink
}

long linux_sys_readlinkat(int dirfd, const(char)* pathname, char* buf, size_t bufsiz)
{
    // Readlink relative to directory FD
    if (pathname is null || buf is null) {
        return setErrno(Errno.EFAULT);
    }
    
    // Delegate to readlink for now
    return linux_sys_readlink(pathname, buf, bufsiz);
}

