int linux_sys_brk(void* addr)
{
    import implementation.kernel.core.heap : kmalloc;
    
    // brk() manages the program break (end of data segment)
    // We maintain a simple heap pointer
    static void* current_brk = null;
    static void* heap_start = null;
    static size_t heap_size = 0;
    
    // Initialize heap on first call
    if (heap_start is null) {
        heap_size = 0x400 * 0x400; // 1MB initial heap
        heap_start = kmalloc(heap_size);
        if (heap_start is null) {
            return cast(int)cast(size_t)null;
        }
        current_brk = heap_start;
    }
    
    // If addr is null, return current break
    if (addr is null) {
        return cast(int)cast(size_t)current_brk;
    }
    
    // Check if new break is within allocated heap
    size_t offset = cast(size_t)addr - cast(size_t)heap_start;
    if (offset > heap_size) {
        // Would need to expand heap - for now, just fail
        return cast(int)cast(size_t)current_brk;
    }
    
    // Update break
    current_brk = addr;
    return cast(int)cast(size_t)current_brk;
}

// Process/Thread management
int linux_sys_clone(ulong flags, void* stack, int* parent_tid, int* child_tid, ulong tls)
{
    // Flags
    enum CLONE_VM = 0x00000100;
    enum CLONE_FS = 0x00000200;
    enum CLONE_FILES = 0x00000400;
    enum CLONE_SIGHAND = 0x00000800;
    enum CLONE_THREAD = 0x00010000;
    enum CLONE_SETTLS = 0x00080000;
    enum CLONE_PARENT_SETTID = 0x00100000;
    enum CLONE_CHILD_CLEARTID = 0x00200000;
    enum CLONE_CHILD_SETTID = 0x01000000;

    auto parent = currentProcess();
    if (parent is null) return setErrno(Errno.ESRCH);

    auto child = allocProc();
    if (child is null) return setErrno(Errno.EAGAIN);

    // Copy parent state to child
    child.fds[] = parent.fds[]; // Naive copy for CLONE_FILES
    child.sigmask = parent.sigmask;
    child.cwd = parent.cwd;
    child.rootCap = parent.rootCap;
    
    // Handle CLONE_VM - Share address space
    if (flags & CLONE_VM)
    {
        // Free the child's allocated page table since we'll share parent's
        if (child.cr3 != 0 && child.ownsCr3)
        {
            import implementation.kernel.core.physmem : freeFrame;
            freeFrame(child.cr3);
        }
        
        // Share parent's page table
        child.cr3 = parent.cr3;
        child.ownsCr3 = false;  // Don't free shared CR3
        
        // CRITICAL: Share parent's VMMap instead of using child's own
        // This ensures that mmap/munmap operations are visible to all threads
        child.vmMapIndex = parent.vmMapIndex;
        child.ownsVmMap = false;  // Don't reset/free shared VMMap
        
        // Update the child's VMMap entry to point to parent's CR3
        // (This is for compatibility, but child should use parent's VMMap via vmMapIndex)
        size_t childIdx = cast(size_t)(child - g_ptable.ptr);
        if (childIdx < g_vmMaps.length)
        {
            g_vmMaps[childIdx]._cr3 = parent.cr3;
        }
        
        // Share heap state (all threads see same heap)
        child.heapBase = parent.heapBase;
        child.heapBrk = parent.heapBrk;
        child.heapLimit = parent.heapLimit;
        child.mmapCursor = parent.mmapCursor;
    }


    // Handle CLONE_THREAD
    if (flags & CLONE_THREAD)
    {
        // Mark as a thread
        child.isThread = true;
        child.threadGroupLeader = parent;
        // Threads own their own kernel stacks (already allocated by allocProc)
        child.ownsKernelStack = true;
        
        child.tgid = parent.tgid;
        child.ppid = parent.ppid;
    }
    else
    {
        // Regular process (not a thread)
        child.isThread = false;
        child.threadGroupLeader = null;
        child.ownsKernelStack = true;
        
        child.tgid = child.pid;
        child.ppid = parent.pid;
    }



    // Handle CLONE_SETTLS - Set Thread-Local Storage
    // TLS (Thread-Local Storage) allows each thread to have its own copy of variables
    // FS_BASE points to the TLS area, GS_BASE is typically used for kernel per-CPU data
    if (flags & CLONE_SETTLS)
    {
        // New thread gets its own TLS area (pthread_create behavior)
        child.fsBase = tls;
        
        // Debug: Log TLS setup
        static if (false)  // Enable for TLS debugging
        {
            import implementation.kernel.io.vga : VGA;
            VGA.write("[TLS] CLONE_SETTLS: child FS_BASE = 0x");
            VGA.writeHex(tls);
            VGA.write(" (parent = 0x");
            VGA.writeHex(parent.fsBase);
            VGA.writeln(")");
        }
    }
    else
    {
        // Inherit parent's TLS (fork-like behavior)
        // This is used when creating processes, not threads
        child.fsBase = parent.fsBase;
    }
    
    // Always inherit GS_BASE from parent
    // GS_BASE is typically used for kernel per-CPU data structures
    child.gsBase = parent.gsBase;


    // Handle TID pointers
    if (flags & CLONE_PARENT_SETTID)
    {
        if (parent_tid !is null) *parent_tid = child.pid;
    }
    
    if (flags & CLONE_CHILD_CLEARTID)
    {
        child.clearChildTid = cast(ulong)child_tid;
    }
    
    if (flags & CLONE_CHILD_SETTID)
    {
        if (child_tid !is null) *child_tid = child.pid;
        child.setChildTid = cast(ulong)child_tid;
    }

    // Setup stack and context
    child.context = parent.context;
    if (stack !is null)
    {
        child.context.regs[6] = cast(size_t)stack; // JMP_RSP
    }
    
    // Stack fixup logic for setjmp/longjmp based switching
    // We need to copy the kernel stack frame that contains the syscall return state.
    // The parent is currently running, so its kernel stack has the frame.
    // We assume the top of the stack contains the syscall frame.
    // We copy the top 512 bytes (should be enough for trap frame).
    
    if (parent.kernelStack !is null && child.kernelStack !is null)
    {
        size_t copySize = 512;
        size_t parentTop = cast(size_t)(parent.kernelStack + parent.kernelStackSize);
        size_t childTop = cast(size_t)(child.kernelStack + child.kernelStackSize);
        
        // Copy top of stack
        memcpy(cast(void*)(childTop - copySize), cast(void*)(parentTop - copySize), copySize);
        
        // Adjust RSP in child context to point to new kernel stack
        // We assume parent's RSP (in context) was pointing somewhere valid in kernel stack.
        // Wait, parent.context is stale if it's running.
        // But we just copied it.
        // We need to set child.context.RSP to a valid location in child's kernel stack.
        // Since we are simulating a return from schedYield (longjmp), we should set RSP
        // to where the saved context expects it.
        // But we don't have a saved context for the *current* execution.
        
        // HACK: We use a trampoline approach.
        // We set child's RIP to a helper that returns 0.
        // But we need to return to USER space.
        // The syscall handler does that.
        
        // Let's rely on the fact that we copied the kernel stack.
        // If we set RSP to the top of the kernel stack (minus frame), 
        // and jump to the syscall exit path?
        
        // For now, let's try setting RSP to top of stack and hope the context switch logic
        // (which calls processEntryWrapper or similar) handles it.
        // Actually, allocProc sets up a context for new processes.
        // We overwrote it with parent.context.
        
        // Let's restore the "new process" context setup but tweak it.
        // allocProc didn't set up context because it expects execve.
        
        // We need to construct a context that, when longjmp'ed to,
        // will pop the trap frame and return to user mode.
        // The trap frame is at childTop - sizeof(TrapFrame).
        
        // This is tricky without exact struct definitions.
        // But `fork` works in AnonymOS?
        // `sys_fork` calls `sys_clone`? No, `sys_fork` is in `syscalls.d`.
        // Let's check `sys_fork` implementation in `syscalls.d`!
        // It might have the logic we need.
    }
    
    // For now, return child PID (parent returns PID, child returns 0)
    // The child needs to know it is the child.
    // Since we can't easily set RAX in the child's context without deep magic,
    // we might have issues.
    // BUT: if we use `setjmp` here?
    
    // See sys_fork implementation for guidance.
    
    return child.pid;
}

