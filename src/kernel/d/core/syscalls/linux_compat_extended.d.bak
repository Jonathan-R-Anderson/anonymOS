// Misc
int linux_sys_uname(void* buf)
{
    // Fill in system information
    struct utsname {
        char[65] sysname;
        char[65] nodename;
        char[65] release;
        char[65] ver;  // Changed from 'version' (D keyword)
        char[65] machine;
    }
    
    if (buf is null) {
        return setErrno(Errno.EFAULT);
    }
    
    auto uts = cast(utsname*)buf;
    import core.stdc.string : strcpy;
    
    // Fill in the fields
    strcpy(uts.sysname.ptr, "AnonymOS");
    strcpy(uts.nodename.ptr, "localhost");
    strcpy(uts.release.ptr, "1.0.0");
    strcpy(uts.ver.ptr, "AnonymOS v1.0");
    strcpy(uts.machine.ptr, "x86_64");
    
    return 0;
}

long linux_sys_getrandom(void* buf, size_t buflen, uint flags)
{
    // Pseudo-random number generator
    // Full implementation would use hardware RNG (RDRAND, /dev/urandom)
    
    if (buf is null || buflen == 0) {
        return setErrno(Errno.EINVAL);
    }
    
    // Simple LCG (Linear Congruential Generator)
    static ulong seed = 0x75BCD15;
    
    ubyte* bytes = cast(ubyte*)buf;
    for (size_t i = 0; i < buflen; i++) {
        seed = seed * 0x41C64E6D + 0x3039;
        bytes[i] = cast(ubyte)(seed >> 32);
    }
    
    return cast(long)buflen;
}

