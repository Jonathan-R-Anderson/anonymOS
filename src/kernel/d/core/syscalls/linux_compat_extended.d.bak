        return setErrno(Errno.EINVAL);
    }
    
    // Would send signal to specific thread here
    return setErrno(Errno.ESRCH);
}

// Synchronization
int linux_sys_futex(int* uaddr, int futex_op, int val, const(void)* timeout, int* uaddr2, int val3)
{
    if (uaddr is null) {
        return setErrno(Errno.EFAULT);
    }
    
    enum FUTEX_WAIT = 0;
    enum FUTEX_WAKE = 1;
    enum FUTEX_PRIVATE_FLAG = 0x80;
    
    int op = futex_op & ~FUTEX_PRIVATE_FLAG;
    auto current = currentProcess();
    
    if (op == FUTEX_WAIT) {
        // Check value
        if (*uaddr != val) {
            return setErrno(Errno.EAGAIN);
        }
        
        // Add to wait list
        auto waiter = cast(FutexWaiter*)kmalloc(FutexWaiter.sizeof);
        if (waiter is null) return setErrno(Errno.ENOMEM);
        
        waiter.pid = current.pid;
        waiter.uaddr = uaddr;
        waiter.next = g_futexWaiters;
        g_futexWaiters = waiter;
        
        // Sleep
        assignProcessState(*current, ProcState.SLEEPING);
        schedYield();
        
        // We woke up. Remove from list if still there.
        FutexWaiter** curr = &g_futexWaiters;
        while (*curr !is null) {
            if (*curr == waiter) {
                *curr = (*curr).next;
                kfree(waiter);
                break;
            }
            curr = &(*curr).next;
        }
        
        return 0;
    } else if (op == FUTEX_WAKE) {
        int woken = 0;
        FutexWaiter** curr = &g_futexWaiters;
        while (*curr !is null && woken < val) {
            if ((*curr).uaddr == uaddr) {
                // Wake up
                auto pid = (*curr).pid;
                auto proc = findByPid(pid);
                if (proc !is null) {
                    assignProcessState(*proc, ProcState.READY);
                }
                
                // Remove
                auto toFree = *curr;
                *curr = (*curr).next;
                kfree(toFree);
                woken++;
            } else {
                curr = &(*curr).next;
            }
        }
        return woken;
    }
    
    return 0;
}

