    if (t < 0 || t >= MAX_TASKS) return 0;
    g_taskPgid[t] = (pgid == 0) ? linuxPidForTask(t) : cast(int)pgid;
    return 0;
}
public long linux_sys_getpgrp() { return 1; }
public long linux_sys_setsid()  { return 1; }
