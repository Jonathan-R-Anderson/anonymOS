# EpinAnonymOS — LKL WiFi config fragment (roadmap/WIFI_AUTODRIVER_ROADMAP.md, W1)
#
# Model A "fat LKL": build ALL common laptop WLAN drivers BUILT-IN (CONFIG_MODULES is
# off in this tree), + the firmware loader; the per-device firmware blobs are fetched at
# install time (W2/W6), not built in.
#
# Apply:  merge into ~/lkl-build/linux/arch/lkl/configs/defconfig, then
#         make ARCH=lkl olddefconfig   (drops invalid symbols + resolves deps)
# Then rebuild liblkl.a and relink lkl-boot-musl (see src/lkl/README.md).

# ── Core 802.11 stack ─────────────────────────────────────────────────────────
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_WLAN=y

# ── Firmware loader (drivers request_firmware() the .ucode/.bin blobs; W2 host-op) ──
CONFIG_FW_LOADER=y
# CONFIG_FW_LOADER_USER_HELPER is not set

# ── Crypto that mac80211 / the WPA handshake needs (CCMP/GCMP/TKIP/WEP) ──────────
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MICHAEL_MIC=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_SHA256=y

# ── PCIe MSI (modern WiFi needs it — see the ★ bridge caveat in the roadmap) ─────
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ── Intel (stock Framework 13: AX200/AX210/AX211/9xxx) ───────────────────────────
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y

# ── Realtek (rtw88 PCIe + rtw89) ─────────────────────────────────────────────────
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_PCI=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8723DE=y
CONFIG_RTW89=y
CONFIG_RTW89_PCI=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852BE=y

# ── MediaTek (mt76 — AMD Framework 13) ───────────────────────────────────────────
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
CONFIG_MT7915E=y

# ── Qualcomm Atheros ─────────────────────────────────────────────────────────────
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y

# ── Broadcom ─────────────────────────────────────────────────────────────────────
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
